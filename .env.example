PORT=3000

# Min. 32 karakter. Contoh: openssl rand -hex 32
JWT_SECRET=

# Base64 dari 32 byte. Contoh: openssl rand -base64 32
ENCRYPTION_KEY=

# Rahasia untuk tanda tangan request. Contoh: openssl rand -hex 32
SIGNING_SECRET=

# Cloudflare Turnstile. Untuk dev, pakai "1x0000000000000000000000000000000AA" (selalu lolos).
TURNSTILE_SECRET_KEY=
DATABASE_URL=
